# Server & Runtime (Railway / Node backend)
NODE_ENV=production
PORT=3000

# Persistent SQLite Database (Railway: attach a volume at /data and set BUDDY_DB_PATH)
# Note: Neither Vercel nor Railway uses a Postgres DATABASE_URL; SQLite persists at BUDDY_DB_PATH on Railway.
BUDDY_DB_PATH=/data/buddy-elder.db

# Gemini AI Configuration (Railway / Server-side only — NEVER use VITE_GEMINI_API_KEY)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Administrator, Messaging, Auth & CORS Configuration (Railway / Server-side only)
JWT_SECRET=
ADMIN_PASSCODE=
APP_URL=https://buddy-ai-agent-3103.vercel.app
ALLOWED_ORIGINS=https://buddy-ai-agent-3103.vercel.app
BUDDY_MESSAGING_NUMBER=

# Frontend API Base URL:
# - Local development (http://localhost:3000) & same-origin Railway: leave empty
# - Vercel production deployment: set to https://buddyaiagent3103-production.up.railway.app
VITE_API_BASE_URL=